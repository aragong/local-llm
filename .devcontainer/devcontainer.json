{
  "name": "local-llm (llama.cpp + pi)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": ["--gpus=all", "--name", "local-llm-dev"],
  "mounts": ["source=llm-models,target=/models,type=volume"],
  "containerUser": "oceanos",
  "remoteUser": "oceanos",
  "containerEnv": {
    "HF_TOKEN": "${localEnv:HF_TOKEN}"
  },
  "overrideCommand": false,
  "init": true,
  "postCreateCommand": "download-models.sh",
  "forwardPorts": [9931]
}
